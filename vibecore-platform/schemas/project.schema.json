{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecore.local/schemas/project.schema.json",
  "title": "VibeCoreLiv3 Project",
  "description": "Projekt = Pattern[] → Scenes → Steps/Notes. Pattern-Domain (siehe docs/05_Project_Runtime.md).",
  "type": "object",
  "required": ["schemaVersion", "bpm", "patterns", "parts", "fx", "master"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "description": "Projektformat-Version für Migration (21_Migration.md)." },
    "name": { "type": "string" },
    "bpm": { "type": "number", "minimum": 20, "maximum": 300 },
    "beatsPerBar": { "type": "integer", "minimum": 1, "maximum": 16, "default": 4 },
    "parts": { "type": "array", "items": { "$ref": "preset.schema.json#/definitions/partRef" } },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "seed", "swing", "scenes"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "seed": { "type": "integer", "minimum": 0 },
          "swing": { "type": "number", "minimum": 0, "maximum": 100 },
          "scenes": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "scene.schema.json" } }
        }
      }
    },
    "fx": { "type": "array", "items": { "type": "object" } },
    "fxRouting": { "type": "string", "enum": ["serial", "parallel", "hybrid"] },
    "master": { "type": "object" },
    "autosave": { "type": "string", "format": "date-time" }
  }
}