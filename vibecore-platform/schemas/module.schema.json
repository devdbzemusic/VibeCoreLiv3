{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecore.local/schemas/module.schema.json",
  "title": "VibeCoreLiv3 Module Manifest",
  "description": "Signiertes Manifest für Host-Geladene Module (06_Host_Runtime.md, 07_SDK.md, 16_Security.md).",
  "type": "object",
  "required": ["api_version", "dsp_version", "module_version", "name", "pins", "signature", "permissions"],
  "properties": {
    "name": { "type": "string" },
    "api_version": { "type": "string", "description": "VK_SDK_API_VERSION (ABI-stabil)." },
    "dsp_version": { "type": "string" },
    "module_version": { "type": "string" },
    "cpu_estimate": { "type": "number", "minimum": 0, "maximum": 100, "description": "Erwartete % bei 48k/256 (03_DSP_Core.md)." },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "direction", "channels"],
        "properties": {
          "id": { "type": "string" },
          "direction": { "type": "string", "enum": ["input", "output"] },
          "channels": { "type": "integer", "minimum": 1, "maximum": 64 }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "enum": ["file_read", "file_write", "network", "asset_access", "midi"] },
      "description": "Berechtigungsmodell (16_Security.md)."
    },
    "signature": { "type": "string", "description": "Ed25519-Signatur des Manifest-Hash." },
    "realtime_validated": { "type": "boolean", "description": "Validator-Bestanden-Flag (07_SDK.md)." }
  }
}